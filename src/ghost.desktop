#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Ghost — voice + screen assistant
Name[ru]=Ghost — voice + screen assistant
Comment=Hidden overlay that listens to system audio and shows Claude answers
Comment[ru]=Скрытый оверлей: слушает системный звук и показывает ответы Claude
Exec=<repo>/ghost/run.sh
Icon=<repo>/ghost/ghost.png
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=false
StartupWMClass=ghost_overlay
X-GNOME-Autostart-enabled=false
